class Solution {
  public:
    // Function to sort a linked list of 0s, 1s and 2s.
    Node* segregate(Node* head) {

        // Add code here
        if ( head -> next == NULL ) return head;
        vector<int> zero;
        vector<int> one;
        vector<int> two;
        Node* temp = head;
        while ( temp != NULL ) {
            if ( temp -> data == 0 ) zero.push_back(temp->data);
            else if ( temp ->data == 1 ) one.push_back(temp -> data);
            else two.push_back(temp -> data);
            temp = temp -> next;
        }
        temp = head;
            for ( int i=0; i<zero.size(); i++ ) {
                temp -> data = zero[i];
                temp = temp -> next;
            }
            for ( int i=0; i<one.size(); i++ ) {
                 temp -> data = one[i];
                temp = temp -> next; 
            }
            for ( int i= 0; i<two.size(); i++ ) {
                temp -> data = two[i];
                temp = temp -> next; 
            }
            return head;
    }
};
