class Solution {
  public:
    int maxValue(vector<int>& arr) {
        // your code here
        if(arr.size()==1)
        return arr[0];
        if(arr.size()==2)
        return max(arr[0],arr[1]);
        int p2=arr[0],p1=max(arr[0],arr[1]),curr1=p1;
        for(int i=2;i<arr.size()-1;i++){
            curr1=max(arr[i]+p2,p1);
            p2=p1;
            p1=curr1;
        }
        p2=arr[1],p1=max(arr[1],arr[2]);
        int curr2=p1;
        for(int i=3;i<arr.size();i++){
            curr2=max(arr[i]+p2,p1);
            p2=p1;
            p1=curr2;
        }
        return max(curr1,curr2);
    }
};
